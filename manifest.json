{
  "manifest_version": 3,
  "name": "Aralık Filtresi – sahibinden.com için",
  "short_name": "Aralık Filtresi",
  "version": "1.0.0",
  "description": "sahibinden.com konut aramasında bina yaşı, oda sayısı, kat sayısı ve bulunduğu katı aralık olarak seçmeyi sağlar.",
  "homepage_url": "https://github.com/erincayaz/sahibinden-aralik-filtresi",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sahibinden.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sahibinden-aralik-filtresi@erincayaz",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

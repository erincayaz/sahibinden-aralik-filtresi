{
  "manifest_version": 3,
  "name": "Sahibinden Aralık Filtresi",
  "version": "0.1.0",
  "description": "Sahibinden konut aramasında bina yaşı, oda sayısı, kat sayısı ve bulunduğu katı aralık olarak seçmeyi sağlar.",
  "content_scripts": [
    {
      "matches": ["https://www.sahibinden.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sahibinden-aralik-filtresi@erincayaz",
      "strict_min_version": "109.0"
    }
  }
}
